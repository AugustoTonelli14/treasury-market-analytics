# --- FRED (Federal Reserve Economic Data) ---
# Obter em: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# --- Ingestion window ---
START_DATE=2015-01-01
# END_DATE: leave unset for "no upper bound" (both connectors default to
# today's data when omitted). A literal "today" string is not parsed as a
# date by either connector and will break the request if set.

# --- DuckDB ---
DUCKDB_PATH=outputs/treasury.duckdb

# --- Logging ---
LOG_LEVEL=INFO

# --- ECB SDW (sem API key, mantido por consistência) ---
ECB_API_BASE_URL=https://data-api.ecb.europa.eu/service/data

# --- BIS Data Portal (bulk CSV downloads, no API key) ---
BIS_OTC_DERIV_URL=https://data.bis.org/static/bulk/WS_OTC_DERIV2_csv_col.zip
BIS_FX_TURNOVER_URL=https://data.bis.org/static/bulk/WS_DER_OTC_TOV_csv_col.zip
